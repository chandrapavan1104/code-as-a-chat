# Copy this file to .env and fill in values.
#
# Note: Claude, Codex, and Gemini use SUBSCRIPTION LOGIN — no API keys needed.
# Run `claude login`, `codex login`, and `gemini` once on this Mac.
# Credentials live in ~/.claude/, ~/.codex/, ~/.gemini/.
#
# API keys below are OPTIONAL fallbacks (only if you don't have a subscription).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ── Telegram client (Phase 3) ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USERS=

# ── API gateway ───────────────────────────────────────────────────────────────
# Shared secret guarding /run and /skills. Leave blank to auto-generate one
# (persisted to ~/.codeasachat/api_token, read by both server and bot).
# Set explicitly only if a remote client (e.g. the future Android app) needs it.
API_TOKEN=

# ── Agent persona ─────────────────────────────────────────────────────────────
# Name of your agent buddy + voice style.
# AGENT_PERSONA=telugu-bestie (default) → Tinglish best-friend voice
# AGENT_PERSONA=professional            → plain assistant voice
AGENT_NAME=Gajala
AGENT_PERSONA=telugu-bestie

# ── Orchestrator behavior ─────────────────────────────────────────────────────
# Skill that handles free-text Telegram messages.
# 'shell' = LLM router that picks the right engine and reformats for mobile.
# 'claude' / 'codex' / 'antigravity' = bypass the router, raw verbose output.
DEFAULT_SKILL=shell

# Model used by the shell skill (Haiku is fast + cheap)
# Aliases: haiku | sonnet | opus  — or a full model name.
SHELL_MODEL=haiku

# Root directory file ops and AI skills work inside.
# Leave blank to default to the HOME_BASE_DIR below (the "general" home base) —
# so non-project asks land somewhere dedicated instead of your bare home dir.
# Can also be changed at runtime via /projects switch — that persists to
# ~/.codeasachat/state.json and overrides this on next server start.
WORKSPACE_DIR=

# The "home base": default workspace for general, non-project work, and the
# baseline you're in when not inside a project. Auto-created (with a starter
# CLAUDE.md) if missing. Defaults to ~/Projects/general.
HOME_BASE_DIR=

# Parent directory scanned by the /projects skill for switchable projects.
# Defaults to ~/Projects if left blank.
PROJECTS_PARENT_DIR=

# Daily billable-token budgets used by /usage to compute a "% used" for
# providers that don't expose a real rate-limit snapshot locally.
# Defaults: Claude=5_000_000, Gemini=10_000_000. Override to taste.
USAGE_BUDGET_CLAUDE=
USAGE_BUDGET_GEMINI=

# ── Push notifications (Gajala Android app, optional) ──────────────────────────
# Path to a Firebase service-account JSON (Firebase Console → Project settings →
# Service accounts → Generate new private key). Enables FCM push to the app for
# reminders/alerts. Defaults to ~/.codeasachat/fcm-service-account.json.
# Leave blank / omit the file to run without push (Telegram still works).
FCM_SERVICE_ACCOUNT=

# ── Background scheduler ───────────────────────────────────────────────────────
# How often (seconds) the scheduler checks reminders + battery. Default 60.
SCHEDULER_INTERVAL=
# Low-battery push alerts. Set false on an always-plugged desktop (e.g. Mac Mini).
# Machines with no battery are skipped automatically regardless.
BATTERY_ALERTS=true
