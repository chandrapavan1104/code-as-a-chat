#!/usr/bin/env python3
"""Open the agent/thread pinned to a project instead of creating a new chat.

Usage: project-agent [project-path]
"""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from server import prefs  # noqa: E402
from server.db import cli_sessions_store, native_sessions  # noqa: E402


def main() -> None:
    workspace = Path(sys.argv[1] if len(sys.argv) > 1 else os.getcwd()).resolve()
    if not workspace.is_dir():
        raise SystemExit(f"Project not found: {workspace}")
    engine = prefs.get_coding_engine(workspace)
    if engine == "auto":
        engine = "claude"
    if engine == "qwen":
        model = prefs.get_coding_model("qwen") or "qwen2.5:7b"
        command = ["ollama", "run", model]
    else:
        found = native_sessions.latest(str(workspace), engine)
        sid = found[0] if found else cli_sessions_store.get(str(workspace), engine)
        commands = {
            "claude": ["claude", "--resume", sid] if sid else ["claude"],
            "codex": ["codex", "resume", sid] if sid else ["codex"],
            "gemini": ["gemini", "--resume", sid] if sid else ["gemini"],
        }
        command = commands[engine]
    print(f"{workspace.name}: {engine} · {' '.join(command)}", flush=True)
    os.chdir(workspace)
    os.execvp(command[0], command)


if __name__ == "__main__":
    main()
