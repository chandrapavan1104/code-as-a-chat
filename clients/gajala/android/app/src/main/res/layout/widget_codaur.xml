<?xml version="1.0" encoding="utf-8"?>
<!-- Dense midnight telemetry panel: live usage rows, quota meters, refresh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CODAUR"
                android:textColor="@color/widget_text"
                android:textSize="17sp"
                android:letterSpacing="0.12"
                android:fontFamily="monospace"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/codaur_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 MODELS  ·  LIVE TOKEN DECK"
                android:textColor="@color/widget_text_dim"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                android:fontFamily="monospace"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/codaur_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/widget_accent"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:paddingEnd="6dp"
            android:maxLines="1" />
        <ImageView
            android:id="@+id/codaur_refresh"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="8dp"
            android:background="@drawable/widget_refresh_bg"
            android:src="@drawable/ic_widget_refresh"
            android:contentDescription="Refresh usage" />
    </LinearLayout>

    <include layout="@layout/widget_usage_row_codex" />
    <include layout="@layout/widget_usage_row_claude" />
    <include layout="@layout/widget_usage_row_gemini" />
    <include layout="@layout/widget_usage_row_qwen" />
</LinearLayout>
